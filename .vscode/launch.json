{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Chronicle Extension (dashboard)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.cjs"]
    }
  ]
}
