{
  "name": "gigai-chronicle-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Gigai Chronicle — build software with AI, never lose the journey. Monorepo root.",
  "license": "MIT",
  "author": "Gigai Kripa Services (https://gigaikripaservices.com)",
  "type": "module",
  "homepage": "https://github.com/cbsshekhawat18-lab/gigai-chronicle#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbsshekhawat18-lab/gigai-chronicle.git"
  },
  "bugs": {
    "url": "https://github.com/cbsshekhawat18-lab/gigai-chronicle/issues"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/check-boundaries.test.mjs scripts/check-cli-pack.test.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/check-boundaries.mjs",
    "changeset": "changeset",
    "test:budgets": "node --test scripts/budget-cold-start.test.mjs",
    "release:check": "node scripts/check-cli-pack.mjs",
    "release": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:scripts && pnpm release:check && pnpm --filter gigai-chronicle publish --access public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
