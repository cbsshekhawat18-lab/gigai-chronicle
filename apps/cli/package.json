{
  "name": "gigai-chronicle",
  "version": "0.3.0",
  "description": "chronicle — your AI development history, recorded in-repo, linked to git, replayable. git blame says who; `chronicle why` says what was asked.",
  "license": "MIT",
  "author": "Gigai Kripa Services (https://gigaikripaservices.com)",
  "type": "module",
  "keywords": [
    "ai",
    "git",
    "history",
    "prompts",
    "claude-code",
    "codex",
    "openai",
    "version-control",
    "provenance",
    "local-first",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/cbsshekhawat18-lab/gigai-chronicle#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbsshekhawat18-lab/gigai-chronicle.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/cbsshekhawat18-lab/gigai-chronicle/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@gigaichronicle/schema": "workspace:^",
    "@gigaichronicle/core": "workspace:^",
    "@gigaichronicle/provider-claude-code": "workspace:^",
    "@gigaichronicle/provider-codex": "workspace:^",
    "commander": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:"
  },
  "bin": {
    "chronicle": "./dist/main.js"
  }
}
