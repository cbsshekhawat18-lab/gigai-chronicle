{
  "name": "gigaichronicle-vscode",
  "version": "0.3.0",
  "description": "Your AI development history — recorded in-repo, linked to git, replayable.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies --out gigaichronicle-vscode.vsix"
  },
  "dependencies": {
    "@gigaichronicle/schema": "workspace:^",
    "@gigaichronicle/core": "workspace:^",
    "@gigaichronicle/provider-codex": "workspace:^",
    "@gigaichronicle/ui": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/vscode": "^1.90.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:"
  },
  "displayName": "Gigai Chronicle",
  "publisher": "gigaichronicle",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.19.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "git",
    "history",
    "prompts",
    "claude-code",
    "codex",
    "openai",
    "version-control",
    "provenance",
    "replay"
  ],
  "activationEvents": [
    "workspaceContains:.chronicle/config.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gigaichronicle",
          "title": "Chronicle",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gigaichronicle": [
        {
          "type": "webview",
          "id": "chronicle.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "chronicle.openTimeline",
        "title": "Chronicle: Open Dashboard",
        "category": "Chronicle",
        "icon": "$(dashboard)"
      },
      {
        "command": "chronicle.replaySession",
        "title": "Chronicle: Replay Session"
      },
      {
        "command": "chronicle.refresh",
        "title": "Chronicle: Refresh",
        "category": "Chronicle",
        "icon": "$(refresh)"
      },
      {
        "command": "chronicle.whyFile",
        "title": "Chronicle: Why is this file like this?",
        "category": "Chronicle",
        "icon": "$(git-commit)"
      },
      {
        "command": "chronicle.savePrompt",
        "title": "Chronicle: Save a prompt to the library",
        "category": "Chronicle",
        "icon": "$(save)"
      },
      {
        "command": "chronicle.newPrompt",
        "title": "Chronicle: New prompt (write one for later)",
        "category": "Chronicle",
        "icon": "$(add)"
      },
      {
        "command": "chronicle.savePromptFromEditor",
        "title": "Chronicle: Save editor as prompt",
        "category": "Chronicle",
        "icon": "$(save)"
      },
      {
        "command": "chronicle.importCodex",
        "title": "Chronicle: Import Codex sessions",
        "category": "Chronicle",
        "icon": "$(cloud-download)"
      },
      {
        "command": "chronicle.contextPack",
        "title": "Chronicle: Copy context pack (brief my AI tool)",
        "category": "Chronicle",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chronicle.openTimeline",
          "when": "view == chronicle.sessions",
          "group": "navigation@1"
        },
        {
          "command": "chronicle.savePrompt",
          "when": "view == chronicle.sessions",
          "group": "navigation@2"
        },
        {
          "command": "chronicle.whyFile",
          "when": "view == chronicle.sessions",
          "group": "navigation@3"
        },
        {
          "command": "chronicle.importCodex",
          "when": "view == chronicle.sessions",
          "group": "navigation@4"
        },
        {
          "command": "chronicle.refresh",
          "when": "view == chronicle.sessions",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "chronicle.whyFile",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "chronicle@1"
        },
        {
          "command": "chronicle.contextPack",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "chronicle@2"
        },
        {
          "command": "chronicle.savePromptFromEditor",
          "when": "editorTextFocus",
          "group": "chronicle@3"
        }
      ],
      "commandPalette": [
        {
          "command": "chronicle.whyFile",
          "when": "editorIsOpen"
        },
        {
          "command": "chronicle.contextPack",
          "when": "editorIsOpen"
        },
        {
          "command": "chronicle.newPrompt"
        },
        {
          "command": "chronicle.savePromptFromEditor",
          "when": "editorIsOpen"
        },
        {
          "command": "chronicle.importCodex"
        }
      ],
      "editor/title/context": [
        {
          "command": "chronicle.whyFile",
          "when": "resourceScheme == file",
          "group": "chronicle@1"
        },
        {
          "command": "chronicle.contextPack",
          "when": "resourceScheme == file",
          "group": "chronicle@2"
        }
      ],
      "explorer/context": [
        {
          "command": "chronicle.whyFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "chronicle@1"
        },
        {
          "command": "chronicle.contextPack",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "chronicle@2"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only in untrusted workspaces: no capture, no hook installation."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cbsshekhawat18-lab/gigai-chronicle.git"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b2430",
    "theme": "dark"
  }
}
