.cache/
.local/

# This public repository does not commit its own captured sessions — the
# founder's prompts are not part of what a cloner needs, and the git history
# was purged of them before launch. Chronicle's default is to SHARE sessions
# (they travel with the repo); this line is a deliberate, repo-specific
# opt-out for the public mirror. Remove it if you want this repo to dogfood
# the shared-journey model in public again.
sessions/

# Derived Project Memory is generated from the sessions above — which this
# public repo does not commit — so it is excluded here too, to guarantee no
# dev-conversation content leaks in via a derived artifact. In a normal repo
# `.chronicle/memory/` IS committed (it travels with the project); this is the
# same deliberate, repo-specific opt-out as `sessions/` above.
memory/
