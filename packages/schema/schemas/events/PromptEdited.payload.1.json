{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chronicle.dev/v1/PromptEdited/1.json",
  "title": "PromptEdited/1",
  "type": "object",
  "properties": {
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "$blob": {
              "type": "string",
              "pattern": "^sha256-[0-9a-f]{64}$"
            }
          },
          "required": [
            "$blob"
          ],
          "additionalProperties": {}
        }
      ]
    },
    "revises": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "text",
    "revises"
  ],
  "additionalProperties": {}
}
