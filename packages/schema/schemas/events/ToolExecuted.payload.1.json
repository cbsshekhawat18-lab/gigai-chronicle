{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chronicle.dev/v1/ToolExecuted/1.json",
  "title": "ToolExecuted/1",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "summary": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "$blob": {
                  "type": "string",
                  "pattern": "^sha256-[0-9a-f]{64}$"
                }
              },
              "required": [
                "$blob"
              ],
              "additionalProperties": {}
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tool",
    "outcome",
    "summary",
    "durationMs"
  ],
  "additionalProperties": {}
}
