{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chronicle.dev/v1/SessionStarted/1.json",
  "title": "SessionStarted/1",
  "type": "object",
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resumedFrom": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ses_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "title",
    "resumedFrom"
  ],
  "additionalProperties": {}
}
